{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NovaCut",
  "version": "0.1.0",
  "identifier": "com.novacut.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build && npm run prepare-ffmpeg && npm run notices",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "NovaCut",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "backgroundColor": "#0e0f12"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "NovaCut",
    "copyright": "© 2026 NovaCut",
    "category": "Video",
    "shortDescription": "Editor de vídeo para Windows",
    "longDescription": "NovaCut é um editor de vídeo desktop: importação de mídias, timeline com várias faixas, pré-visualização, ajustes por clipe e exportação MP4 com FFmpeg.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "ffmpeg/*": "ffmpeg/",
      "licenses/*": "licenses/"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["PortugueseBR"],
        "displayLanguageSelector": false
      }
    }
  }
}
